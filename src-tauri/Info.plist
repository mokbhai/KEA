<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>KEA needs microphone access for dictation and meeting transcription.</string>
	<!-- Calendar, for naming a recording after the event it happened during.
	     BOTH keys, not one: macOS 14 split calendar access into full/write-only
	     and reads NSCalendarsFullAccessUsageDescription, while 13 and earlier
	     read NSCalendarsUsageDescription. A request with no matching string for
	     the running system KILLS the process, exactly as for the microphone. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>KEA reads the title of the calendar event you are recording, so your meeting is named after it. Your calendar is read on this Mac and is never sent to an AI provider.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>KEA reads the title of the calendar event you are recording, so your meeting is named after it. Your calendar is read on this Mac and is never sent to an AI provider.</string>
	<!-- The kea:// URL scheme. LaunchServices routes `open kea://…` to this
	     bundle as a kAEGetURL Apple Event, which Tauri surfaces as
	     RunEvent::Opened; see src/api/mod.rs. This file is already merged into
	     the built bundle's Info.plist — the NSServices entry below is the
	     proof, since the Services menu item it declares works today — so the
	     scheme registers with no plugin and no tauri.conf.json change.
	     Verify after `make install` with:
	       plutil -p /Applications/KEA.app/Contents/Info.plist -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.kea.desktop.url</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kea</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Rewrite with KEA</string>
			</dict>
			<key>NSMessage</key>
			<string>rewriteWithKEA</string>
			<key>NSPortName</key>
			<string>KEA</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

