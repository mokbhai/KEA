{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KEA",
  "version": "0.1.0",
  "identifier": "ai.kea.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "title": "KEA", "width": 900, "height": 640, "visible": true }],
    "trayIcon": { "id": "main", "iconPath": "icons/128x128.png" },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/mokbhai/vox/releases/latest/download/latest.json"
      ]
    }
  }
}
